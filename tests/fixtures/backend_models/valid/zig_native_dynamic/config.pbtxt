name: "zig_native_dynamic"
backend: "zig_passthrough"
max_batch_size: 8
input [{ name: "IN0" data_type: TYPE_INT32 dims: [4] }]
output [{ name: "OUT0" data_type: TYPE_INT32 dims: [4] }]
dynamic_batching { preferred_batch_size: [8] max_queue_delay_microseconds: 10000 }
instance_group [{ kind: KIND_CPU count: 1 }]
